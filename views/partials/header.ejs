<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Nature Monitoring Action</title>
  <link rel="icon" type="image/png" href="/favicon.png">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/ol@v7.5.2/ol.css" />
</head>

<body>
  <div class="window-container">
    <div class="window-bar">
      <span class="window-title">Environmental Protection Agency</span>
    </div>

    <% if (user) { %>
      <nav>
        <a href="/photos">Home</a>
        <a href="/photos/new">Take Picture</a>
        <a href="/photos/map">Map</a>

        <% if (user.role==='admin' ) { %>
          <a href="/admin" style="color: var(--gold);">Admin Panel</a>
          <% } %>

            <span class="spacer"></span>

            <span>👤 <%= user.username %> (<%= user.role %>)</span>
            <form action="/logout" method="POST" class="inline-form">
              <input type="hidden" name="_method" value="DELETE">
              <button type="submit" class="btn-logout">Logout</button>
            </form>
      </nav>
      <% } %>

        <main class="window-content">