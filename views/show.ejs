<%- include('partials/header') %>
  <div class="detail-view">
    <h2>
      <%= photo.caption %>
    </h2>
    <img src="/photos/image/<%= photo.filename %>" alt="<%= photo.caption %>" class="main-image">

    <div class="meta-info">
      <% if (photo.metadata.capturedDate) { %>
        <p>📅 <strong>
            <%= photo.metadata.capturedDate %>
          </strong></p>
        <p>🕒 Captured at <strong>
            <%= photo.metadata.capturedTime %>
          </strong></p>
        <% } else { %>
          <p>📅 <%= new Date(photo.metadata.capturedAt).toLocaleString() %>
          </p>
          <% } %>

            <p>🧭 Heading: <%= photo.metadata.compassHeading ? photo.metadata.compassHeading.toFixed(1) + '°' : 'N/A' %>
            </p>
            <p>📍 Coords: <%= photo.metadata.latitude?.toFixed(4) || 'N/A' %>, <%= photo.metadata.longitude?.toFixed(4)
                  || 'N/A' %>
            </p>
            <p>🏷️ AI Recognized: <%= photo.labels.map(l=> l.label).join(', ') || 'None' %></p>
    </div>

    <div class="actions">
      <a href="/photos" class="btn-secondary">Back to Home</a>

      <% if (isOwner || isAdmin) { %>
        <a href="/photos/<%= photo._id %>/edit" class="btn-primary">Edit</a>

        <form action="/photos/<%= photo._id %>?_method=DELETE" method="POST" class="inline-form">
          <button type="submit" class="btn-danger" onclick="return confirm('Delete this photo?')">Delete</button>
        </form>
        <% } %>
    </div>
  </div>
  <%- include('partials/footer') %>