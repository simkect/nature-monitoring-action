<%- include('partials/header') %>
  <h2>Your Contributions</h2>

  <!-- ===== FILTER BAR ===== -->
<form method="GET" action="/photos" class="filter-bar">
  <input type="text" name="search" placeholder="Search caption..." value="<%= filters.search || '' %>">
  
  <select name="user">
    <option value="">All Users</option>
    <% users.forEach(u => { %>
      <option value="<%= u._id %>" <%= filters.user === u._id.toString() ? 'selected' : '' %>>
        <%= u.username %>
      </option>
    <% }) %>
  </select>

  <select name="label">
    <option value="">All Objects</option>
    <% allLabels.forEach(l => { %>
      <option value="<%= l %>" <%= filters.label === l ? 'selected' : '' %>><%= l %></option>
    <% }) %>
  </select>

  <!-- Quick date buttons -->
  <button type="button" class="btn-small" onclick="setDate(0)">Today</button>
  <button type="button" class="btn-small" onclick="setDate(7)">Last 7 days</button>
  <button type="button" class="btn-small" onclick="setDate(30)">Last 30 days</button>

  <input type="date" name="dateFrom" id="dateFrom" value="<%= filters.dateFrom || '' %>">
  <input type="date" name="dateTo" id="dateTo" value="<%= filters.dateTo || '' %>">

  <button type="submit" class="btn-primary btn-small">Filter</button>
  <a href="/photos" class="btn-secondary btn-small">Clear</a>
</form>

  <!-- ===== PHOTO GRID ===== -->
  <div class="photo-grid">
    <% if (photos.length===0) { %>
      <p>No photos match your filters.</p>
      <% } %>
        <% photos.forEach(photo=> { %>
          <div class="photo-card">
            <a href="/photos/<%= photo._id %>" class="card-image-link">
              <img src="/photos/image/<%= photo.filename %>" alt="<%= photo.caption %>">
            </a>
            <div class="card-content">
              <p class="card-title">
                <%= photo.caption %>
              </p>
              <div class="card-actions">
                <a href="/photos/<%= photo._id %>" class="btn-view">View</a>
                <% if (photo.author._id.toString()===user._id.toString() || user.role==='admin' ) { %>
                  <a href="/photos/<%= photo._id %>/edit" class="btn-view">Edit</a>
                  <% } %>
              </div>
              <div class="card-meta">
                <a href="/photos/user/<%= photo.author._id %>" class="user-link">
                  👤 <%= photo.author.username %>
                </a>
              </div>
            </div>
          </div>
          <% }) %>
  </div>
  <script src="/js/index.js"></script>
  <%- include('partials/footer') %>