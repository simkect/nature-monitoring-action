<%- include('partials/header') %>

<h2>Map of Contributions</h2>

<div class="map-wrapper">
  <!-- Layer switcher button -->
  <div class="map-layer-btn" id="layerBtn" onclick="toggleLayerMenu()">
    🗺️ <span id="current-layer-name">OpenStreetMap</span> ▾
  </div>

  <!-- Hidden layer list -->
  <div class="map-layer-menu" id="layerMenu">
    <div class="layer-option" onclick="changeLayer('osm', 'OpenStreetMap')">OpenStreetMap</div>
    <div class="layer-option" onclick="changeLayer('google', 'Google Maps')">Google Maps</div>
    <div class="layer-option" onclick="changeLayer('dark', 'Google Dark')">Google Dark Mode</div>
    <div class="layer-option" onclick="changeLayer('esri', 'Esri Satellite')">Esri Satellite</div>
  </div>

  <div id="map"></div>
</div>

<script id="photos-data" type="application/json">
  <%- JSON.stringify(photos.map(p => ({
    filename: p.filename,
    caption: p.caption,
    latitude: p.metadata && p.metadata.latitude,
    longitude: p.metadata && p.metadata.longitude,
    compassHeading: p.metadata && p.metadata.compassHeading,
    capturedAt: p.metadata && p.metadata.capturedAt,
    labels: p.labels || []
  }))) %>
</script>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/ol@v7.5.2/ol.css" />
<script src="https://cdn.jsdelivr.net/npm/ol@v7.5.2/dist/ol.js"></script>
<script src="/js/map.js"></script>
<%- include('partials/footer') %>